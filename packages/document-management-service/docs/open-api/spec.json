					},
					"cause": {
						"$ref": "#/components/schemas/Error"
					}
				},
				"required": [
					"name",
					"message"
				]
			},
			"NotFoundResponse": {
				"type": "object",
				"properties": {
					"notFoundId": {
						"type": "string",
