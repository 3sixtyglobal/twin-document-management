	"components": {
		"schemas": {
			"Document": {
				"description": "Interface describing a document.",
				"type": "object",
				"properties": {
					"@context": {
						"type": "array",
						"prefixItems": [
							{
								"const": "https://schema.org"
							},
							{
								"const": "https://schema.twindev.org/documents/"
							},
							{
								"const": "https://schema.twindev.org/common/"
							}
						],
						"items": {
							"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
						},
						"minItems": 3,
						"description": "JSON-LD Context."
					},
					"type": {
						"const": "Document",
						"description": "JSON-LD Type."
					},
					"id": {
						"type": "string",
						"description": "The full id of the document."
					},
					"documentRevision": {
						"type": "number",
						"description": "The revision of the document as a 0 based index."
					},
					"blobStorageId": {
						"type": "string",
						"description": "The blob storage id for the document."
					},
					"integrity": {
						"type": "string",
						"description": "The integrity of the blob data."
					},
					"attestationId": {
						"type": "string",
						"description": "The attestation for the document if one was created."
					},
					"dateCreated": {
						"type": "string",
						"description": "The date/time of when the document was created."
					},
					"dateModified": {
						"type": "string",
						"description": "The date/time of when the document was modified."
					},
					"dateDeleted": {
						"type": "string",
						"description": "The date/time of when the document was deleted, as we never actually remove items."
					},
					"organizationIdentity": {
						"type": "string",
						"description": "The organization which added the document to the graph."
					},
					"userIdentity": {
						"type": "string",
						"description": "The user who added the document to the graph."
					}
				},
				"required": [
					"@context",
					"type",
					"id",
					"documentRevision",
					"blobStorageId",
					"integrity",
					"dateCreated"
				],
				"allOf": [
					{
						"$ref": "#/components/schemas/DocumentBase"
					}
				]
			},
			"DocumentBase": {
				"description": "Interface describing a document base.",
				"type": "object",
				"properties": {
					"documentId": {
						"type": "string",
						"description": "The id of the document."
					},
					"documentIdFormat": {
						"type": "string",
						"description": "The format of the document id."
					},
					"documentCode": {
						"$ref": "https://schema.twindev.org/unece/UneceDocumentCodeList"
					},
					"annotationObject": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdNodeObject"
					}
				},
				"required": [
					"documentId",
					"documentCode"
				]
			},
			"DocumentHydrated": {
				"description": "Interface describing a hydrated document which includes additional information that can be optionally requested when retrieving a document.",
				"type": "object",
				"properties": {
					"blobStorageEntry": {
						"$ref": "https://schema.twindev.org/blob-storage/BlobStorageEntry"
					},
					"extractedData": {
						"description": "The data extracted from the document using data extraction services."
					},
					"attestationInformation": {
						"$ref": "https://schema.twindev.org/attestation/AttestationInformation"
					}
				},
				"allOf": [
					{
						"$ref": "#/components/schemas/Document"
					}
				]
			},
			"DocumentList": {
				"description": "Interface describing a list of document entries.",
				"type": "object",
				"properties": {
					"@context": {
						"type": "array",
						"prefixItems": [
							{
								"const": "https://schema.org"
							},
							{
								"const": "https://schema.twindev.org/documents/"
							},
							{
								"const": "https://schema.twindev.org/common/"
							}
						],
						"items": {
							"$ref": "https://schema.twindev.org/json-ld/JsonLdContextDefinitionElement"
						},
						"minItems": 3,
						"description": "JSON-LD Context."
					},
					"type": {
						"const": "ItemList",
						"description": "JSON-LD Type."
					},
					"itemListElement": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/DocumentHydrated"
						},
						"description": "The list of documents."
					},
					"edges": {
						"type": "array",
						"items": {
							"type": "string"
						},
						"description": "The ids of the other vertices which are connected to the document."
					}
				},
				"required": [
					"@context",
					"type",
					"itemListElement"
				]
			},
			"DocumentManagementCreateRequest": {
				"type": "object",
				"properties": {
					"document": {
						"$ref": "#/components/schemas/DocumentBase"
					},
					"blob": {
						"type": "string",
						"description": "The data to create the document with, either as base64-encoded content or an existing blob storage entry id."
					},
					"auditableItemGraphEdges": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/DocumentManagementEdgeEntry"
						},
						"description": "The auditable item graph vertices to connect the document to."
					},
					"options": {
						"type": "object",
						"properties": {
							"includeAttestation": {
								"type": "boolean",
								"description": "Flag to create an attestation for the document, defaults to false."
							},
							"includeAlias": {
								"type": "boolean",
								"description": "Flag to add the document id as an alias to the aig vertex, defaults to true."
							},
							"aliasAnnotationObject": {
								"$ref": "https://schema.twindev.org/json-ld/JsonLdNodeObject"
							}
						},
						"description": "Additional options for the create operation."
					}
				},
				"required": [
					"document",
					"blob"
				],
				"description": "The body parameters."
			},
			"DocumentManagementEdgeEntry": {
				"description": "A single edge entry used when connecting a document to an AIG vertex.",
				"type": "object",
				"properties": {
					"targetId": {
						"type": "string",
						"description": "The target AIG vertex id to connect to."
					},
					"includeAlias": {
						"type": "boolean",
						"description": "Whether to add the document id as an alias on the connected vertex, defaults to false."
					},
					"aliasAnnotationObject": {
						"$ref": "https://schema.twindev.org/json-ld/JsonLdNodeObject"
					}
				},
				"required": [
					"targetId"
				]
			},
			"DocumentManagementUpdatePartialRequest": {
				"type": "object",
				"properties": {
					"document": {
						"description": "The document base properties to update. annotationObject, documentIdFormat and documentCode are applied in-place to the current revision.",
						"type": "object",
						"properties": {
							"documentIdFormat": {
								"type": "string",
								"description": "The format of the document id."
							},
							"documentCode": {
								"$ref": "https://schema.twindev.org/unece/UneceDocumentCodeList"
							},
							"annotationObject": {
								"$ref": "https://schema.twindev.org/json-ld/JsonLdNodeObject"
							}
						}
					},
					"blob": {
						"type": "string",
						"description": "The data to update the document with, either as base64-encoded content or an existing blob storage entry id."
					},
					"auditableItemGraphEdges": {
						"type": "object",
						"properties": {
							"add": {
								"type": "array",
								"items": {
									"$ref": "#/components/schemas/DocumentManagementEdgeEntry"
								},
								"description": "Connections to add; each entry creates a back-edge on the connected vertex."
							},
							"remove": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "Target vertex IDs to disconnect; their back-edges are removed."
							}
						},
						"description": "Explicit edge delta to apply. Use `add` to create new connections and `remove` to\ndisconnect existing ones by their target vertex id."
					},
					"options": {
						"type": "object",
						"properties": {
							"includeAttestation": {
								"type": "boolean",
								"description": "Set to true to start attesting the document (even if originally created without attestation), or false to remove the existing attestation. Omit to leave attestation state unchanged."
							},
							"includeAlias": {
								"type": "boolean",
								"description": "Set to true to add the document id as an alias on the aig vertex, or false to remove it. Omit to leave alias state unchanged."
							},
							"aliasAnnotationObject": {
								"$ref": "https://schema.twindev.org/json-ld/JsonLdNodeObject"
							}
						},
						"description": "Additional options for the update operation."
					}
				},
				"description": "The body parameters."
			},
			"Error": {
				"description": "Model to describe serialized error.",
				"type": "object",
				"properties": {
